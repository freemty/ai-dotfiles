[user]
	name = freemty
	email = yangyuanbo04@gmail.com
[url "ssh://git@github.com/"]
        insteadOf = https://github.com/
[http "https://github.com"]
	proxy = socks5://127.0.0.1:7890
[https "https://github.com"]
	proxy = socks5://127.0.0.1:1086
[http]
	proxy = http://127.0.0.1:7890
	sslVerify = false
	postBuffer = 524288000
	lowSpeedLimit = 1000
	lowSpeedTime = 60
[https]
	proxy = http://127.0.0.1:7890
[credential]
	helper = store
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
	line-numbers = true
[url "https://git:olp_6k72jtn2ZypWcgUKQq7bwsj8ZWNlqo0oAp2m@git.overleaf.com/"]
	insteadOf = https://git.overleaf.com/
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
